existing=$(live)
if [ -n "$existing" ]; then
  if [ "$REBUILD" = 1 ]; then
    note "rebuilding - closing the old one first"
    close_all; sleep 1
  else
    note "already running ($existing) - focusing it (--rebuild to start over)"
    if [ "$FOCUS" = 1 ]; then
      if [ "$BACKEND" = herdr ]; then h_focus "$(printf '%s' "$existing" | awk '{print $1}')"; else t_focus; fi
    fi
    exit 0
