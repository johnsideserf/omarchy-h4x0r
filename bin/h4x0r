if [ "$BACKEND" = herdr ]; then
  ws_json=$(h_new) || die "herdr workspace create failed"
  WS=$(printf '%s' "$ws_json" | jget result.workspace.workspace_id) || die "no workspace id"
  TOP=$(printf '%s' "$ws_json" | jget result.root_pane.pane_id)     || die "no root pane"
  split() { h_split "$@"; }; launch() { h_run "$@"; }
else
