_payload netlink.sh <<'__PAYLOAD_NETLINK_SH__'
#!/bin/bash
# Real live network sockets, dressed up. Colors follow the same H4X0R_*
# environment the python panes read; phosphor green when unset.
esc() { # esc <hex> -> truecolor escape
  local h=${1#\#}
  printf '\033[38;2;%d;%d;%dm' "0x${h:0:2}" "0x${h:2:2}" "0x${h:4:2}"
}
HEAD=$(esc "${H4X0R_HEAD:-ffffff}")
BRIGHT=$(esc "${H4X0R_BRIGHT:-87ff87}")
MAIN=$(esc "${H4X0R_MAIN:-00d75f}")
MID=$(esc "${H4X0R_MID:-00af5f}")
DEEP=$(esc "${H4X0R_DEEP:-005f00}")
R=$'\033[0m'

while true; do
  printf '\033[H\033[2J%s  :: LIVE UPLINKS ::%s  %s%s%s\n\n' "$HEAD" "$R" "$DEEP" "$(date '+%F %T')" "$R"
  ss -tunp 2>/dev/null | awk -v deep="$DEEP" -v main="$MAIN" -v mid="$MID" -v bright="$BRIGHT" -v r="$R" '
    NR==1 {printf "%s%s%s\n", deep, $0, r; next}
    {c=main; if ($1=="udp") c=mid; if ($0 ~ /ESTAB/) c=bright;
     printf "%s%s%s\n", c, substr($0,1,200), r}' | head -n $(( $(tput lines) - 5 ))
  sleep 2
done
__PAYLOAD_NETLINK_SH__


if [ "$ACTION" = extract ]; then
  note "pane scripts are in $HACKER_DIR"
  exit 0
fi

# ---------------------------------------------------------------------------
# palette: the Omarchy theme, or one of the named CRT palettes
# ---------------------------------------------------------------------------
ENVP=""
theme_env() {
  [ -r "$THEME_DIR/colors.toml" ] || return 1
  python3 - "$THEME_DIR/colors.toml" <<'PYEOF'
import sys, re
try:
    import tomllib
    with open(sys.argv[1], "rb") as fh: t = tomllib.load(fh)
except Exception:
    t = {}
    for line in open(sys.argv[1], encoding="utf-8", errors="replace"):
        m = re.match(r'\s*([a-z_]+)\s*=\s*"([^"]+)"', line)
        if m: t[m.group(1)] = m.group(2)

def pick(*names):
    for n in names:
        v = t.get(n)
        if isinstance(v, str) and re.fullmatch(r"#?[0-9a-fA-F]{6}", v.strip()):
            return v.strip().lstrip("#")
    return None

roles = {
    "HEAD":   pick("bright_foreground", "light_foreground", "foreground"),
    "BRIGHT": pick("light_foreground", "foreground", "accent"),
    "MAIN":   pick("foreground", "accent"),
    "MID":    pick("accent", "foreground"),
    "DIM":    pick("dark_foreground", "muted"),
    "DEEP":   pick("muted", "selection", "lighter_background"),
    "ALERT":  pick("yellow", "orange", "bright_yellow"),
    "WARN":   pick("bright_red", "red", "magenta"),
}
if not roles["MAIN"]:
    sys.exit(1)
print(" ".join("H4X0R_%s=%s" % (k, v) for k, v in roles.items() if v))
PYEOF
}

# Named palettes, for when you would rather not match the desktop. Roles are
# HEAD BRIGHT MAIN MID DIM DEEP ALERT WARN - brightest to nearly-background,
# plus two accents for "something happened" and "something bad happened".
palette_env() {
  case "$1" in
    phosphor|green)  echo "ffffff 87ff87 00d75f 00af5f 00875f 005f00 ffaf00 ff2a2a" ;;  # P1 CRT
    amber)           echo "fff2d0 ffd479 ffb000 d98f00 a86b00 4a2f00 fff200 ff5c1a" ;;  # P3 CRT
    ice)             echo "ffffff b3f6ff 4fd6ff 27a9d9 1b7ba6 0a3a4a ffd166 ff5c7a" ;;  # cold blue
    crimson)         echo "ffd7de ff6b8a e01040 b00c33 7a0a24 3d0512 ffb000 ff2a2a" ;;  # red alert
    synthwave)       echo "fdf6ff ff8ae2 f92aad c01d8a 7a1a63 2b0a3d 36f9f6 ff5555" ;;  # hot pink
    mono)            echo "ffffff e0e0e0 b8b8b8 8a8a8a 5c5c5c 2e2e2e ffffff ff5555" ;;  # grey
    *) return 1 ;;
  esac
}

named_env() {
  local vals roles i=0 out=""
  vals=$(palette_env "$1") || return 1
  roles="HEAD BRIGHT MAIN MID DIM DEEP ALERT WARN"
  set -- $vals
  for r in $roles; do
    i=$((i + 1)); eval "v=\${$i}"
    out="$out H4X0R_$r=$v"
  done
  printf '%s' "${out# }"
}

case "$THEME" in
  omarchy|theme|auto)
    if ENVP=$(theme_env) && [ -n "$ENVP" ]; then
      ENVP="$ENVP "
      note "recoloring from the current Omarchy theme"
    else
      ENVP=""
      [ "$THEME" != auto ] && note "no readable theme palette - staying phosphor green"
    fi ;;
  *)
    if ENVP=$(named_env "$THEME") && [ -n "$ENVP" ]; then
      ENVP="$ENVP "
      note "palette: $THEME"
    else
      ENVP=""
    fi ;;
esac

