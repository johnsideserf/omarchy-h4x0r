TITLE_MAP=()
BOOT="$HACKER_DIR/boot.py"

# Wrap each command in boot.py so the pane types a bring-up line first, and
# stagger the launches - the grid fills in one pane at a time.
launch_pane() { # pane label cmd
  local pane="$1" label="$2" cmd="$3"
  [ -n "$pane" ] || die "a split failed - layout incomplete"
  TITLE_MAP+=("$pane"$'\t'"$label")
  if [ "$INSTANT" = 0 ]; then
    cmd="python3 $(printf '%q' "$BOOT") $(printf '%q' "$label") $(printf '%q' "$cmd")"
  fi
  launch "$pane" "$label" "$ENVP$cmd"
  [ "$INSTANT" = 0 ] && sleep 0.28
  return 0
}

M="python3 $HACKER_DIR/matrix.py"
PROC="watch -c -n 1 -t 'ps -eo pid,pcpu,pmem,comm --sort=-pcpu | head -n 10'"

# ratios say what the ORIGINAL pane keeps, so 0.28 leaves 28% and splits off 72%
build_grid() {
  local BOT CLI A B C D A2 C2 C3 C2b D2 D3
  BOT=$(split "$TOP" down  0.72 )   # full-width strip along the bottom
  CLI=$(split "$BOT" right 0.38 )   # uplinks 38% | audio 62%
  A=$TOP
  B=$(split "$A"   right 0.28 )     # A keeps 28%; B..D share the rest
  C=$(split "$B"   right 0.179)     # B is the narrow full-height rain stripe
  D=$(split "$C"   right 0.59 )
  A2=$(split "$A"  down  0.62 )     # btop over a rain
  C2=$(split "$C"  down  0.283)     # banner over ...
  C3=$(split "$C2" down  0.578)     # ... a nested row over the memdump
  C2b=$(split "$C2" right 0.585)    # that nested row splits sideways - the seam
  D2=$(split "$D"  down  0.226)     # three unequal rows down the right edge
  D3=$(split "$D2" down  0.537)

  launch_pane "$A"   "▓ THE GIBSON ▓"  "$MON"
  launch_pane "$B"   "▓ RAIN 01 ▓"     "$M"
  launch_pane "$C"   "▓ STATUS ▓"      "python3 $HACKER_DIR/banner.py"
  launch_pane "$C2"  "▓ INTRUSION ▓"   "python3 $HACKER_DIR/intrusion.py"
  launch_pane "$C2b" "▓ SWEEP ▓"       "python3 $HACKER_DIR/radar.py"
  launch_pane "$C3"  "▓ MEMDUMP ▓"     "python3 $HACKER_DIR/hexfeed.py"
  launch_pane "$D"   "▓ PROC ▓"        "$PROC"
  launch_pane "$D2"  "▓ SYSLOG ▓"      "journalctl -f -n 40 --no-hostname"
  launch_pane "$D3"  "▓ KERNEL RING ▓" "journalctl -kf -n 30 --no-hostname"
  launch_pane "$A2"  "▓ RAIN 02 ▓"     "$M"
  launch_pane "$BOT" "▓ UPLINKS ▓"     "bash $HACKER_DIR/netlink.sh"
  launch_pane "$CLI" "$AUDIO_LABEL"    "$AUDIO_CMD"
}

# Five big panes - readable across a room, good on a second monitor.
build_cinema() {
  local BOT CLI R R2
  BOT=$(split "$TOP" down  0.70 )
  CLI=$(split "$BOT" right 0.42 )
  R=$(split "$TOP"  right 0.55 )
  R2=$(split "$R"   down  0.50 )

  launch_pane "$TOP" "▓ RAIN 01 ▓"    "$M"
  launch_pane "$R"   "▓ THE GIBSON ▓" "$MON"
  launch_pane "$R2"  "▓ INTRUSION ▓"  "python3 $HACKER_DIR/intrusion.py"
  launch_pane "$BOT" "▓ UPLINKS ▓"    "bash $HACKER_DIR/netlink.sh"
  launch_pane "$CLI" "$AUDIO_LABEL"   "$AUDIO_CMD"
}

# Three panes - the look without giving up the whole machine.
build_minimal() {
  local R R2
  R=$(split "$TOP" right 0.35 )
  R2=$(split "$R"  down  0.60 )

  launch_pane "$TOP" "▓ RAIN 01 ▓"    "$M"
  launch_pane "$R"   "▓ THE GIBSON ▓" "$MON"
  launch_pane "$R2"  "▓ SYSLOG ▓"     "journalctl -f -n 40 --no-hostname"
}

case "$LAYOUT" in
  grid)    build_grid ;;
  cinema)  build_cinema ;;
  minimal) build_minimal ;;
esac

# tmux pane titles must be re-applied once the programs own the ptys: the
# shell prompt's title escape overwrites anything set before the command runs
if [ "$BACKEND" = tmux ]; then
  sleep 2
  for entry in "${TITLE_MAP[@]}"; do
    tmux select-pane -t "${entry%%$'\t'*}" -T "${entry#*$'\t'}" >/dev/null 2>&1
  done
  tmux select-pane -t "$TOP" >/dev/null 2>&1
fi

if [ "$FOCUS" = 1 ]; then
  if [ "$BACKEND" = herdr ]; then h_focus "$WS"; else t_focus; fi
fi
note "$BACKEND: $WS is up - $LAYOUT, ${#TITLE_MAP[@]} panes. close it with: h4x0r --close"
